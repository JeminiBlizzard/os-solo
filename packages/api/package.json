    "@os-solo/shared": "workspace:^",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "cron-parser": "^5.5.0",
    "drizzle-orm": "^0.38.3",
    "express": "5",
    "express-rate-limit": "^8.4.1",
    "helmet": "^8.1.0",
    "openai": "^6.34.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
